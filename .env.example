# Copy this file to .env and fill in real values. .env is gitignored.

# Hopsworks (required for feature pipeline, training pipeline, and dashboard)
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=aqi_karachi_forecast

# AQICN (optional secondary live-reading source; rotate any token that has
# ever been committed or pasted elsewhere before using it here)
AQICN_API_TOKEN=

# Location (defaults to Karachi if unset)
AQI_CITY=karachi
AQI_LAT=24.8607
AQI_LON=67.0011
AQI_TIMEZONE=Asia/Karachi

# Backfill window length in days
AQI_BACKFILL_DAYS=90
