# Copy this file to .env and fill in real values. .env is gitignored.

# Hopsworks (required for feature pipeline, training pipeline, and dashboard)
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=aqi_karachi_forecast

# AQICN (optional secondary live-reading source; rotate any token that has
# ever been committed or pasted elsewhere before using it here)
AQICN_API_TOKEN=

# Default single city for scripts/back-compat only (see config.CITIES for the
# full list of cities the pipelines and dashboard actually run against —
# Karachi, Lahore, Islamabad, Faisalabad, Multan, Peshawar, Quetta,
# Hyderabad, Abbottabad, Rawalpindi).
AQI_CITY=karachi
AQI_LAT=24.8607
AQI_LON=67.0011
AQI_TIMEZONE=Asia/Karachi

# Backfill window length in days (weather history comes from Open-Meteo's
# archive endpoint, which serves years of data; air-quality history is only
# real/non-null from ~2022-09 onward, so there's little value going further back)
AQI_BACKFILL_DAYS=365
